# Worker: ingesta asíncrona, cola hacia n8n y purga LOPDP. Sin exposición pública.
# PROHIBIDO aquí: AWS_*, WHATSAPP_*, SMTP_* (el correo y WhatsApp los envía n8n).
ENVIRONMENT=staging
PAKTAI_INSTITUTION_ID=hackathon-colegio
DATABASE_URL=postgresql://paktai_app:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/ca.crt
EPAKTI_ENGINE_BASE_URL=http://localhost:8090/api/v1
EPAKTI_ENGINE_API_KEY=dev-stub-key-replace-in-prod
WORKER_ENGINE_TIMEOUT_MS=5000
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_BASE_MS=2000
# Webhooks de n8n (ver docs/N8N_WEBHOOKS.md). El secreto firma cada envío con HMAC-SHA256.
N8N_WEBHOOK_BASE_URL=https://n8n.epakti.ec/webhook
N8N_WEBHOOK_HMAC_SECRET=
PII_RETENTION_DAYS=365
STAGING_EMAIL=
STAGING_ALLOWLIST=
# Colegio que el worker carga en el motor de Wilo (cabecera X-School-Id y datos de alta).
EPAKTI_SCHOOL_ID=SCH-DEMO-E2E
EPAKTI_SCHOOL_NAME=UE Piloto Ficticio Cuenca
EPAKTI_SCHOOL_DPA=010150
EPAKTI_SCHOOL_REGIME=Sierra-Amazonía
EPAKTI_FECHA_CORTE=2025-10-31
# Token que n8n exige en el webhook del borrador (Header Auth «X-Epakti-Webhook-Token»), además de la firma HMAC.
N8N_WEBHOOK_TOKEN=
