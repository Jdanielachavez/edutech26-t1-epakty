# API / BFF: lo único que habla con el navegador. PROHIBIDO aquí: SUPABASE_SERVICE_ROLE_KEY, AWS_*, WHATSAPP_*, SMTP_*,
# MIGRATION_DATABASE_URL. Si alguno está presente, la API se niega a arrancar.
ENVIRONMENT=staging
PAKTAI_INSTITUTION_ID=hackathon-colegio
# Login de ejecución (rol con RLS, sin permisos de migración). En Supabase: un rol propio, no service_role.
DATABASE_URL=postgresql://paktai_app:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/ca.crt
# JSON token -> rol. Roles: admin, rectoria, dece, tutor (con course y parallel), inspeccion, colecturia, admisiones,
# worker (n8n: reservar caso y guardar borrador), n8n_callback (solo EP-11), epakti_ceo, epakti_mlops, epakti_ds, epakti_cs.
PAKTAI_AUTH_TOKENS={}
# Inicio de sesión con usuario y contraseña. PAKTAI_USERS = administrador inicial (python -m scripts.create_user); el resto se
# crea desde la pantalla Usuarios. SESSION_SECRET firma las sesiones (mínimo 32 caracteres).
PAKTAI_USERS={}
SESSION_SECRET=
SESSION_TTL_MINUTES=480
LOGIN_RATE_LIMIT_PER_MIN=8
# Colegio ante el motor de Wilo.
EPAKTI_SCHOOL_ID=SCH-DEMO-E2E
# Motor de Wilo. Desarrollo: stub local. Producción: https://engine.epakti.ec/api/v1 (solo se cambia esta línea y la clave).
EPAKTI_ENGINE_BASE_URL=http://localhost:8090/api/v1
EPAKTI_ENGINE_API_KEY=dev-stub-key-replace-in-prod
CORS_ORIGINS=https://epakti.ec
CONTACT_RATE_LIMIT_PER_MIN=5
# Pon 1 solo si la API está detrás del proxy de compose (para leer la IP real en el límite del formulario).
TRUST_PROXY_HEADERS=1
PII_RETENTION_DAYS=365
STAGING_EMAIL=
STAGING_ALLOWLIST=
