# n8n: el ÚNICO lugar con credenciales de IA, WhatsApp y correo.
# Obligatoria: cifra las credenciales guardadas en n8n. Generar: python -c "import secrets;print(secrets.token_urlsafe(48))". Guárdala: sin ella no se recuperan.
N8N_ENCRYPTION_KEY=
# Dirección pública (solo webhooks) y comportamiento detrás del proxy.
WEBHOOK_URL=https://n8n.epakti.ec/
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=America/Guayaquil
# Los flujos de entrega/contacto/errores verifican la firma HMAC en un nodo Code: necesita leer esta variable.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Permite `require('crypto')` en los nodos Code (verificación de firma HMAC). Sin esto el flujo falla cerrado: rechaza todo con error 500.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_WEBHOOK_HMAC_SECRET=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EPAKTI_SALES_EMAIL=
# Flujo del motor (epakti-alerta-360): correo de PRUEBA a un destinatario interno y callback EP-11 al motor.
EPAKTI_MAIL_FROM=E-Pakty <cuenta-smtp@dominio>
EPAKTI_TEST_RECIPIENT_EMAIL=destinatario-interno@dominio
# Callback: la URL del motor terminada en /api/v1 y el token que entrega Wilo (no reutilizar uno compartido por chat).
EPAKTI_CALLBACK_BASE_URL=https://<motor>/api/v1
EPAKTI_CALLBACK_TOKEN=
