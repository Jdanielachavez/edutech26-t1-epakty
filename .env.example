# This deployment uses ONLY the official synthetic school dataset.
ENVIRONMENT=staging
PAKTAI_INSTITUTION_ID=hackathon-colegio
# Get this from Supabase > Connect > Direct or Session pooler. Never commit password.
# Schema is paktai_edu; do not expose it to the browser or Supabase anonymous API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=/certs/supabase-ca.crt
# Migration connection with DDL permissions, used only by migrate.py.
MIGRATION_DATABASE_URL=
# JSON mapping random tokens (>=32 characters) to server-side roles/scopes.
# Roles: admin, rectoria, dece, tutor (con course y parallel), inspeccion, colecturia, admisiones, worker (n8n).
PAKTAI_AUTH_TOKENS={}
API_DOMAIN=
PAKTAI_API_URL=
CORS_ORIGINS=
# n8n existing instance (do not use webhook-test)
N8N_BASE_URL=
N8N_API_KEY=
WEBHOOK_N8N_URL=
WEBHOOK_N8N_TOKEN=
# Flujo n8n de alertas 360 del motor (POST /webhook/epakti-alerta-360). Usa WEBHOOK_N8N_TOKEN.
WEBHOOK_N8N_360_URL=
# Carpeta con los resultados del motor (por defecto data/motor; ver scripts/import_motor.py).
PAKTAI_MOTOR_DIR=
N8N_WEBHOOK_CREDENTIAL_ID=
N8N_API_CREDENTIAL_ID=
N8N_AWS_CREDENTIAL_ID=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Prefer IAM role or AWS_PROFILE. Never grant runtime IAM administration rights.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
STAGING_EMAIL=
STAGING_PHONE=
STAGING_ALLOWLIST=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
