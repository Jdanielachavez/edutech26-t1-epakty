      ],
      "parameters": {
        "method": "POST",
        "url": "={{'http://host.docker.internal:8000' + '/api/v1/interventions/' + $json.student.intervention_id + '/claim'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "epApiWorker",
          "name": "E-Pakty API worker"
        }
      }
    },
    {
      "id": "claimed",
      "name": "Caso reservado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
