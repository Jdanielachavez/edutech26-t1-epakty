{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAKTAI approved institutional risk model",
  "type": "object",
  "required": ["model_id", "version", "status", "training", "validation", "thresholds", "intercept", "features"],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "approved"},
    "training": {
      "type": "object",
      "required": ["data_mode", "real_outcomes", "institution_id", "outcome_counts"],
      "properties": {
        "data_mode": {"const": "production"},
        "real_outcomes": {"const": true},
        "institution_id": {"type": "string", "minLength": 1},
        "outcome_counts": {
          "type": "object",
          "required": ["PERMANECE", "RETIRA"],
          "properties": {
            "PERMANECE": {"type": "integer", "minimum": 1},
            "RETIRA": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["temporal_holdout_passed", "calibration_passed", "approved_by", "metrics"],
      "properties": {
        "temporal_holdout_passed": {"const": true},
        "calibration_passed": {"const": true},
        "approved_by": {"type": "string", "minLength": 1},
        "metrics": {"type": "object", "minProperties": 1}
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["moderate", "critical"],
      "properties": {
        "moderate": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "critical": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "intercept": {"type": "number"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "mean", "scale", "coefficient", "group", "missing_policy"],
        "properties": {
          "field": {"type": "string"},
          "mean": {"type": "number"},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "coefficient": {"type": "number"},
          "group": {"enum": ["academico", "socioemocional_conductual", "financiero"]},
          "missing_policy": {"enum": ["reject", "mean"]}
        }
      }
    }
  }
}
